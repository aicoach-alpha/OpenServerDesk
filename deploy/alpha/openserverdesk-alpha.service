[Unit]
Description=OpenServerDesk Alpha 0.7 (parallel service)
After=network.target

[Service]
Type=simple
Environment=OSD_HOST=192.168.31.31
Environment=OSD_PORT=18691
Environment=OSD_DEPLOYMENT_TIER=alpha
WorkingDirectory=/opt/openserverdesk-dev/alpha/releases/0.7.0-alpha.12/server
ExecStart=/usr/bin/python3 -B /opt/openserverdesk-dev/alpha/releases/0.7.0-alpha.12/server/app.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
