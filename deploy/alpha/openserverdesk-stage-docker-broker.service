[Unit]
Description=OpenServerDesk stage-owned read-only Docker metadata facade (Dozzle pilot)
Requires=openserverdesk-stage-docker-broker.socket
After=network.target openserverdesk-stage-docker-broker.socket
Before=openserverdesk-alpha.service

[Service]
Type=simple
WorkingDirectory=/home/andre/projects/openserverdesk/alpha/releases/0.7.0-alpha.49/server
ExecStart=/usr/bin/python3 -B /home/andre/projects/openserverdesk/alpha/releases/0.7.0-alpha.49/server/stage_docker_api_broker.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=160M
CPUQuota=60%
TasksMax=48

[Install]
WantedBy=default.target
