[Unit]
Description=OpenServerDesk stage-owned read-only Docker metadata facade (Dozzle pilot)
After=network.target
Before=openserverdesk-alpha.service

[Service]
Type=simple
WorkingDirectory=/home/andre/openserverdesk-alpha/releases/0.7.0-alpha.17/server
ExecStart=/usr/bin/python3 -B /home/andre/openserverdesk-alpha/releases/0.7.0-alpha.17/server/stage_docker_api_broker.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
MemoryMax=96M
CPUQuota=30%
TasksMax=36

[Install]
WantedBy=default.target
